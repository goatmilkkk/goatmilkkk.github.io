    {
      "id": "oIkhoJhVTIIgG7RHKyov7",
      "type": "text",
      "x": 418.2851924458864,
      "y": -1.459082074605135,
      "width": 952.508999540963,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 188783892,
      "version": 160,
      "versionNonce": 568487212,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793371995381,
      "created": 1793371962177,
      "link": null,
      "locked": false,
      "text": "    @GetMapping(\"/lessons\")\n    public List<Map<String, Object>> list(\n        @RequestParam(name = \"q\", required = false) String q,\n        @RequestParam(name = \"order\", required = false) String orderBy) {\n\n        var query = dsl.select(ID, SLUG, TITLE).from(LESSON).where(DSL.noCondition());\n\n        if (q != null && !q.isBlank()) {\n            String pattern = \"%\" + q + \"%\";\n            query = query.and(TITLE.likeIgnoreCase(pattern).or(BODY.likeIgnoreCase(pattern)));\n        }\n\n        return query.orderBy(DSL.field(orderBy == null ? \"id\" : orderBy)).fetchMaps();\n    }",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    @GetMapping(\"/lessons\")\n    public List<Map<String, Object>> list(\n        @RequestParam(name = \"q\", required = false) String q,\n        @RequestParam(name = \"order\", required = false) String orderBy) {\n\n        var query = dsl.select(ID, SLUG, TITLE).from(LESSON).where(DSL.noCondition());\n\n        if (q != null && !q.isBlank()) {\n            String pattern = \"%\" + q + \"%\";\n            query = query.and(TITLE.likeIgnoreCase(pattern).or(BODY.likeIgnoreCase(pattern)));\n        }\n\n        return query.orderBy(DSL.field(orderBy == null ? \"id\" : orderBy)).fetchMaps();\n    }",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
